//! Diff operation - compare two tables for schema and data differences
//!
//! This module provides comprehensive diff capabilities for comparing tables,
//! including schema comparison and data-level row differences. It uses hash-based
//! row matching for efficient large-file comparison and supports streaming.

use std::collections::{HashMap, HashSet};
use std::sync::Arc;
use std::time::Instant;

use arrow::array::{Array, ArrayRef};
use arrow::datatypes::{DataType, Field, Schema};
use arrow::record_batch::RecordBatch;
use arrow::compute;
use arrow_row::{RowConverter, SortField};
use serde::Serialize;

use crate::core::formats::{FormatHandler, ReadOptions};
use crate::error::{Error, Result};

/// Options for diff operation
#[derive(Debug, Clone)]
pub struct DiffOptions {
    /// Compare metadata (row count, file size, etc.)
    pub compare_metadata: bool,

    /// Compare schema (column names and types)
    pub compare_schema: bool,

    /// Compare data rows (can be slow for large files)
    pub compare_data: bool,

    /// Ignore row order when comparing
    pub ignore_order: bool,

    /// Sample size for data comparison (None = compare all)
    pub sample_size: Option<usize>,

    /// Columns to ignore during comparison
    pub ignore_columns: Option<Vec<String>>,

    /// Key columns for row matching (if None, hash entire row)
    pub key_columns: Option<Vec<String>>,

    /// Tolerance for floating point comparisons
    pub float_tolerance: f64,

    /// Maximum number of differences to report
    pub max_differences: usize,
}

impl Default for DiffOptions {
    fn default() -> Self {
        Self {
            compare_metadata: true,
            compare_schema: true,
            compare_data: false,
            ignore_order: true,
            sample_size: None,
            ignore_columns: None,
            key_columns: None,
            float_tolerance: 1e-9,
            max_differences: 100,
        }
    }
}

/// Operation for comparing two tables
pub struct DiffOperation {
    left_handler: Arc<dyn FormatHandler>,
    right_handler: Arc<dyn FormatHandler>,
}

impl DiffOperation {
    /// Create a new diff operation
    pub fn new(
        left_handler: Arc<dyn FormatHandler>,
        right_handler: Arc<dyn FormatHandler>,
    ) -> Self {
        Self {
            left_handler,
            right_handler,
        }
    }

    /// Execute diff
    pub async fn execute(
        &self,
        options: &DiffOptions,
        left_path: String,
        right_path: String,
    ) -> Result<DiffResult> {
        // Always compare schemas (needed for data display), but only show if requested
        let schema_diff = self.compare_schemas().await?;

        // Compare metadata
        let metadata_diff = if options.compare_metadata {
            Some(self.compare_metadata().await?)
        } else {
            None
        };

        // Compare statistics (only if schema comparison is requested)
        let stats_diff = if options.compare_schema {
            Some(self.compare_statistics().await?)
        } else {
            None
        };

        // Compare data
        let (row_diffs, summary, left_batches, right_batches, left_schema, right_schema) = if options.compare_data {
            self.compare_data(options).await?
        } else {
            (Vec::new(), DiffSummary::default(), Vec::new(), Vec::new(), Arc::new(Schema::empty()), Arc::new(Schema::empty()))
        };

        Ok(DiffResult {
            left_path,
            right_path,
            schema_diff,
            schema_compared: options.compare_schema,
            metadata_diff,
            stats_diff,
            row_diffs,
            summary,
            left_batches,
            right_batches,
            left_schema,
            right_schema,
        })
    }

    /// Compare schemas of both tables
    async fn compare_schemas(&self) -> Result<SchemaDiff> {
        let left_schema = self.left_handler.read_schema().await?;
        let right_schema = self.right_handler.read_schema().await?;

        let left_fields: HashMap<_, _> = left_schema
            .fields()
            .iter()
            .map(|f| (f.name().clone(), f.data_type().clone()))
            .collect();

        let right_fields: HashMap<_, _> = right_schema
            .fields()
            .iter()
            .map(|f| (f.name().clone(), f.data_type().clone()))
            .collect();

        let left_names: HashSet<_> = left_fields.keys().cloned().collect();
        let right_names: HashSet<_> = right_fields.keys().cloned().collect();

        // Find added and removed columns
        let columns_added: Vec<String> = right_names.difference(&left_names).cloned().collect();
        let columns_removed: Vec<String> = left_names.difference(&right_names).cloned().collect();

        // Find type changes
        let mut columns_type_changed = Vec::new();
        for col_name in left_names.intersection(&right_names) {
            let left_type = &left_fields[col_name];
            let right_type = &right_fields[col_name];

            if left_type != right_type {
                columns_type_changed.push((
                    col_name.clone(),
                    left_type.clone(),
                    right_type.clone(),
                ));
            }
        }

        // Store all schema information
        let left_schema_vec: Vec<_> = left_schema
            .fields()
            .iter()
            .map(|f| (f.name().clone(), f.data_type().clone()))
            .collect();

        let right_schema_vec: Vec<_> = right_schema
            .fields()
            .iter()
            .map(|f| (f.name().clone(), f.data_type().clone()))
            .collect();

        Ok(SchemaDiff {
            columns_added,
            columns_removed,
            columns_type_changed,
            left_schema: left_schema_vec,
            right_schema: right_schema_vec,
        })
    }

    /// Compare metadata of both tables
    async fn compare_metadata(&self) -> Result<MetadataDiff> {
        let left_meta = self.left_handler.read_metadata().await?;
        let right_meta = self.right_handler.read_metadata().await?;

        let num_rows = match (left_meta.num_rows, right_meta.num_rows) {
            (Some(l), Some(r)) => Some((l, r)),
            _ => None,
        };

        let compressed_size = match (left_meta.compressed_size, right_meta.compressed_size) {
            (Some(l), Some(r)) => Some((l, r)),
            _ => None,
        };

        let uncompressed_size = match (left_meta.uncompressed_size, right_meta.uncompressed_size) {
            (Some(l), Some(r)) => Some((l, r)),
            _ => None,
        };

        let compression = match (left_meta.compression, right_meta.compression) {
            (Some(l), Some(r)) => Some((l, r)),
            _ => None,
        };

        let format_version = match (left_meta.format_version, right_meta.format_version) {
            (Some(l), Some(r)) => Some((l, r)),
            _ => None,
        };

        Ok(MetadataDiff {
            num_rows,
            compressed_size,
            uncompressed_size,
            compression,
            format_version,
        })
    }

    /// Compare statistics of both tables
    async fn compare_statistics(&self) -> Result<StatsDiff> {
        let left_stats = self.left_handler.read_statistics().await?;
        let right_stats = self.right_handler.read_statistics().await?;

        // Build maps for easier lookup
        let left_map: HashMap<_, _> = left_stats.iter().map(|s| (s.name.clone(), s)).collect();
        let right_map: HashMap<_, _> = right_stats.iter().map(|s| (s.name.clone(), s)).collect();

        // Get all column names from both sides
        let all_columns: HashSet<_> = left_map.keys().chain(right_map.keys()).cloned().collect();

        let mut column_diffs = Vec::new();

        for col_name in all_columns {
            let left = left_map.get(&col_name);
            let right = right_map.get(&col_name);

            let min_value = match (left, right) {
                (Some(l), Some(r)) => match (&l.min_value, &r.min_value) {
                    (Some(lv), Some(rv)) => Some((lv.clone(), rv.clone())),
                    _ => None,
                },
                _ => None,
            };

            let max_value = match (left, right) {
                (Some(l), Some(r)) => match (&l.max_value, &r.max_value) {
                    (Some(lv), Some(rv)) => Some((lv.clone(), rv.clone())),
                    _ => None,
                },
                _ => None,
            };

            let mean = match (left, right) {
                (Some(l), Some(r)) => match (l.mean, r.mean) {
                    (Some(lv), Some(rv)) => Some((lv, rv)),
                    _ => None,
                },
                _ => None,
            };

            let null_count = match (left, right) {
                (Some(l), Some(r)) => match (l.null_count, r.null_count) {
                    (Some(lv), Some(rv)) => Some((lv, rv)),
                    _ => None,
                },
                _ => None,
            };

            // Only include if there's at least some data to compare
            if min_value.is_some() || max_value.is_some() || mean.is_some() || null_count.is_some()
            {
                column_diffs.push(ColumnStatsDiff {
                    name: col_name,
                    min_value,
                    max_value,
                    mean,
                    null_count,
                });
            }
        }

        Ok(StatsDiff { column_diffs })
    }

    /// Compare data between tables
    async fn compare_data(&self, options: &DiffOptions) -> Result<(Vec<RowDiff>, DiffSummary, Vec<RecordBatch>, Vec<RecordBatch>, Arc<Schema>, Arc<Schema>)> {
        let start_total = Instant::now();

        // Read data from both tables
        let mut read_opts = ReadOptions::builder().batch_size(8192);

        if let Some(sample) = options.sample_size {
            read_opts = read_opts.limit(sample);
        }

        let read_options = read_opts.build();

        let start_io = Instant::now();
        let left_batches = self.left_handler.read_batches(&read_options).await?;
        let right_batches = self.right_handler.read_batches(&read_options).await?;
        eprintln!("[TIMING] I/O (read batches): {:?}", start_io.elapsed());

        // Count total rows
        let left_rows: usize = left_batches.iter().map(|b| b.num_rows()).sum();
        let right_rows: usize = right_batches.iter().map(|b| b.num_rows()).sum();

        // Get schemas
        let left_schema = self.left_handler.read_schema().await?;
        let right_schema = self.right_handler.read_schema().await?;

        // Determine columns to compare
        let compare_columns = self.get_compare_columns(&left_schema, &right_schema, options)?;

        if compare_columns.is_empty() {
            return Ok((
                Vec::new(),
                DiffSummary {
                    left_rows: left_rows as i64,
                    right_rows: right_rows as i64,
                    rows_identical: 0,
                    rows_added: 0,
                    rows_removed: 0,
                    rows_modified: 0,
                },
                left_batches,
                right_batches,
                Arc::new(left_schema),
                Arc::new(right_schema),
            ));
        }

        // Create unified schema for semantic comparison (allows comparing even when types differ)
        let start_unify = Instant::now();
        let unified_schema = Self::create_unified_schema(&left_schema, &right_schema, &compare_columns)?;
        eprintln!("[TIMING] Create unified schema: {:?}", start_unify.elapsed());

        // Hash rows from both sides using unified schema
        let start_hash_left = Instant::now();
        let left_row_hashes = self.hash_batches_with_data(
            &left_batches,
            &left_schema,
            &unified_schema,
            &compare_columns,
        )?;
        eprintln!("[TIMING] Hash left ({} rows): {:?}", left_rows, start_hash_left.elapsed());

        let start_hash_right = Instant::now();
        let right_row_hashes = self.hash_batches_with_data(
            &right_batches,
            &right_schema,
            &unified_schema,
            &compare_columns,
        )?;
        eprintln!("[TIMING] Hash right ({} rows): {:?}", right_rows, start_hash_right.elapsed());

        // Find differences (with unified schema, hash match = row match, no need for value comparison)
        let start_matching = Instant::now();
        let mut row_diffs = Vec::new();
        let mut rows_identical = 0;

        // Track which right rows were matched
        let mut right_matched: HashSet<u64> = HashSet::new();

        // Compare left rows against right
        for (hash, left_location) in &left_row_hashes {
            if let Some(right_location) = right_row_hashes.get(hash) {
                // Row exists in both (hash match = identical with unified schema)
                rows_identical += 1;
                right_matched.insert(*hash);
            } else {
                // Row removed in right
                if row_diffs.len() < options.max_differences {
                    row_diffs.push(RowDiff {
                        diff_type: RowDiffType::Removed,
                        row_key: Some(*hash),
                        column_changes: None,
                        left_row: Some(*left_location),
                        right_row: None,
                    });
                }
            }
        }

        // Find rows added in right
        let rows_added = right_row_hashes.len() - right_matched.len();
        for (hash, right_location) in &right_row_hashes {
            if !right_matched.contains(hash) && row_diffs.len() < options.max_differences {
                row_diffs.push(RowDiff {
                    diff_type: RowDiffType::Added,
                    row_key: Some(*hash),
                    column_changes: None,
                    left_row: None,
                    right_row: Some(*right_location),
                });
            }
        }

        let rows_removed = left_row_hashes.len() - rows_identical;
        let rows_modified = 0; // With unified schema, no modified rows (either identical or different)
        eprintln!("[TIMING] Matching/comparison: {:?}", start_matching.elapsed());

        let summary = DiffSummary {
            left_rows: left_rows as i64,
            right_rows: right_rows as i64,
            rows_identical: rows_identical as i64,
            rows_added: rows_added as i64,
            rows_removed: rows_removed as i64,
            rows_modified: rows_modified as i64,
        };

        eprintln!("[TIMING] Total compare_data: {:?}", start_total.elapsed());
        Ok((row_diffs, summary, left_batches, right_batches, Arc::new(left_schema), Arc::new(right_schema)))
    }

    /// Get columns to compare (respecting ignore_columns)
    fn get_compare_columns(
        &self,
        left_schema: &Schema,
        right_schema: &Schema,
        options: &DiffOptions,
    ) -> Result<Vec<String>> {
        let left_cols: HashSet<_> = left_schema
            .fields()
            .iter()
            .map(|f| f.name().clone())
            .collect();
        let right_cols: HashSet<_> = right_schema
            .fields()
            .iter()
            .map(|f| f.name().clone())
            .collect();

        let common_cols: Vec<String> = left_cols.intersection(&right_cols).cloned().collect();

        let compare_cols = if let Some(ignore) = &options.ignore_columns {
            let ignore_set: HashSet<_> = ignore.iter().cloned().collect();
            common_cols
                .into_iter()
                .filter(|c| !ignore_set.contains(c))
                .collect()
        } else {
            common_cols
        };

        Ok(compare_cols)
    }

    /// Hash all batches for comparison (legacy, returns only values)
    fn hash_batches(
        &self,
        batches: &[RecordBatch],
        schema: &Schema,
        compare_columns: &[String],
        options: &DiffOptions,
    ) -> Result<HashMap<u64, Vec<String>>> {
        let mut row_hashes = HashMap::new();

        for batch in batches {
            for row_idx in 0..batch.num_rows() {
                let mut row_values = Vec::new();
                let mut hash_parts = Vec::new();

                for col_name in compare_columns {
                    let col_idx = schema.index_of(col_name).map_err(|_| {
                        Error::General(format!("Column '{}' not found in schema", col_name))
                    })?;

                    let array = batch.column(col_idx);
                    let value = Self::array_value_to_string(array, row_idx);

                    row_values.push(value.clone());
                    hash_parts.push(format!("{}:{}", col_name, value));
                }

                let hash = Self::compute_hash(&hash_parts);
                row_hashes.insert(hash, row_values);
            }
        }

        Ok(row_hashes)
    }

    /// Hash all batches using RowConverter for performance (lazy - no string conversion)
    ///
    /// This function uses RowConverter (SIMD-optimized) for fast hashing without
    /// converting data to strings. Row locations are stored for lazy materialization.
    fn hash_batches_with_data(
        &self,
        batches: &[RecordBatch],
        original_schema: &Schema,
        unified_schema: &Schema,
        compare_columns: &[String],
    ) -> Result<HashMap<u64, RowLocation>> {
        let mut row_hashes = HashMap::new();

        // Create RowConverter for the unified schema (for fast hashing)
        let sort_fields: Vec<SortField> = unified_schema
            .fields()
            .iter()
            .map(|f| SortField::new(f.data_type().clone()))
            .collect();

        let mut converter = RowConverter::new(sort_fields)
            .map_err(|e| Error::General(format!("Failed to create RowConverter: {}", e)))?;

        for (batch_idx, batch) in batches.iter().enumerate() {
            // Convert to unified schema for consistent hashing
            let unified_columns: Result<Vec<ArrayRef>> = unified_schema
                .fields()
                .iter()
                .map(|field| {
                    let col_name = field.name();
                    let original_idx = original_schema.index_of(col_name)
                        .map_err(|_| Error::General(format!("Column '{}' not found", col_name)))?;

                    let original_array = batch.column(original_idx);
                    let original_type = original_array.data_type();
                    let target_type = field.data_type();

                    // Cast if needed
                    if original_type == target_type {
                        Ok(Arc::clone(original_array))
                    } else {
                        compute::cast(original_array, target_type)
                            .map_err(|e| Error::General(format!(
                                "Failed to cast '{}' from {:?} to {:?}: {}",
                                col_name, original_type, target_type, e
                            )))
                    }
                })
                .collect();

            let unified_columns = unified_columns?;
            let unified_batch = RecordBatch::try_new(
                Arc::new(unified_schema.clone()),
                unified_columns,
            ).map_err(|e| Error::General(format!("Failed to create unified batch: {}", e)))?;

            // Convert to rows using RowConverter (SIMD-optimized)
            let rows = converter.convert_columns(&unified_batch.columns())
                .map_err(|e| Error::General(format!("Failed to convert rows: {}", e)))?;

            // Hash each row and store location (no string conversion!)
            for row_idx in 0..batch.num_rows() {
                let row = rows.row(row_idx);
                let row_bytes = row.as_ref();

                // Hash the binary row with xxHash
                use xxhash_rust::xxh3::Xxh3;
                let mut hasher = Xxh3::new();
                hasher.update(row_bytes);
                let hash = hasher.digest();

                // Store only the location - strings will be materialized on demand
                row_hashes.insert(hash, RowLocation { batch_idx, row_idx });
            }
        }

        Ok(row_hashes)
    }

    /// Convert array value to string for comparison
    fn array_value_to_string(array: &ArrayRef, index: usize) -> String {
        if array.is_null(index) {
            return "NULL".to_string();
        }

        arrow::util::display::array_value_to_string(array, index)
            .unwrap_or_else(|_| "ERROR".to_string())
    }

    /// Compute hash for row identification using xxHash (fast, non-cryptographic)
    fn compute_hash(parts: &[String]) -> u64 {
        use xxhash_rust::xxh3::Xxh3;

        let mut hasher = Xxh3::new();
        for part in parts {
            hasher.update(part.as_bytes());
            hasher.update(b"|"); // Separator to avoid collision between ["ab", "c"] and ["a", "bc"]
        }
        hasher.digest()
    }

    /// Create a unified schema that can represent both left and right schemas
    /// This allows us to compare data semantically even when types differ
    fn create_unified_schema(
        left_schema: &Schema,
        right_schema: &Schema,
        compare_columns: &[String],
    ) -> Result<Schema> {
        let mut unified_fields = Vec::new();

        for col_name in compare_columns {
            let left_field = left_schema.field_with_name(col_name).ok();
            let right_field = right_schema.field_with_name(col_name).ok();

            let unified_type = match (left_field, right_field) {
                (Some(l), Some(r)) => {
                    Self::unify_data_types(l.data_type(), r.data_type())?
                }
                (Some(l), None) => l.data_type().clone(),
                (None, Some(r)) => r.data_type().clone(),
                (None, None) => {
                    return Err(Error::General(format!(
                        "Column '{}' not found in either schema",
                        col_name
                    )));
                }
            };

            unified_fields.push(Field::new(col_name, unified_type, true));
        }

        Ok(Schema::new(unified_fields))
    }

    /// Find a common data type that can represent both types
    fn unify_data_types(left: &DataType, right: &DataType) -> Result<DataType> {
        // If types match, use as-is
        if left == right {
            return Ok(left.clone());
        }

        // Try to find a compatible type
        match (left, right) {
            // String can parse to most types, prefer the non-string type
            (DataType::Utf8, other) | (other, DataType::Utf8) => Ok(other.clone()),
            (DataType::LargeUtf8, other) | (other, DataType::LargeUtf8) => Ok(other.clone()),

            // Numeric types - promote to wider type
            (DataType::Int8, DataType::Int16) | (DataType::Int16, DataType::Int8) => Ok(DataType::Int16),
            (DataType::Int8 | DataType::Int16, DataType::Int32) | (DataType::Int32, DataType::Int8 | DataType::Int16) => Ok(DataType::Int32),
            (DataType::Int8 | DataType::Int16 | DataType::Int32, DataType::Int64) | (DataType::Int64, DataType::Int8 | DataType::Int16 | DataType::Int32) => Ok(DataType::Int64),

            (DataType::UInt8, DataType::UInt16) | (DataType::UInt16, DataType::UInt8) => Ok(DataType::UInt16),
            (DataType::UInt8 | DataType::UInt16, DataType::UInt32) | (DataType::UInt32, DataType::UInt8 | DataType::UInt16) => Ok(DataType::UInt32),
            (DataType::UInt8 | DataType::UInt16 | DataType::UInt32, DataType::UInt64) | (DataType::UInt64, DataType::UInt8 | DataType::UInt16 | DataType::UInt32) => Ok(DataType::UInt64),

            (DataType::Float32, DataType::Float64) | (DataType::Float64, DataType::Float32) => Ok(DataType::Float64),

            // Date types - convert to common representation
            (DataType::Date32, DataType::Date64) | (DataType::Date64, DataType::Date32) => Ok(DataType::Date64),

            // If we can't unify, fall back to string representation
            _ => {
                eprintln!("[WARN] Cannot unify types {:?} and {:?}, using string representation", left, right);
                Ok(DataType::Utf8)
            }
        }
    }

    /// Cast a RecordBatch to a new schema
    fn cast_batch_to_schema(
        batch: &RecordBatch,
        target_schema: &Schema,
    ) -> Result<RecordBatch> {
        let mut new_columns = Vec::new();

        for field in target_schema.fields() {
            let col_name = field.name();

            // Find column in original batch
            let original_idx = batch.schema().index_of(col_name).map_err(|_| {
                Error::General(format!("Column '{}' not found in batch", col_name))
            })?;

            let original_array = batch.column(original_idx);
            let original_type = original_array.data_type();
            let target_type = field.data_type();

            // Cast if needed
            let casted_array = if original_type == target_type {
                Arc::clone(original_array)
            } else {
                compute::cast(original_array, target_type)
                    .map_err(|e| Error::General(format!(
                        "Failed to cast column '{}' from {:?} to {:?}: {}",
                        col_name, original_type, target_type, e
                    )))?
            };

            new_columns.push(casted_array);
        }

        RecordBatch::try_new(Arc::new(target_schema.clone()), new_columns)
            .map_err(|e| Error::General(format!("Failed to create record batch: {}", e)))
    }

    /// Check if two rows are equal (with float tolerance)
    fn rows_equal(&self, left: &[String], right: &[String], options: &DiffOptions) -> bool {
        if left.len() != right.len() {
            return false;
        }

        for (l, r) in left.iter().zip(right.iter()) {
            if !Self::values_equal(l, r, options.float_tolerance) {
                return false;
            }
        }

        true
    }

    /// Compare two values with float tolerance
    fn values_equal(left: &str, right: &str, tolerance: f64) -> bool {
        if left == right {
            return true;
        }

        // Try parsing as floats for tolerance comparison
        if let (Ok(left_f), Ok(right_f)) = (left.parse::<f64>(), right.parse::<f64>()) {
            return (left_f - right_f).abs() < tolerance;
        }

        false
    }

    /// Find specific column changes between two rows
    fn find_column_changes(
        &self,
        left: &[String],
        right: &[String],
        columns: &[String],
        options: &DiffOptions,
    ) -> Vec<(String, String, String)> {
        let mut changes = Vec::new();

        for (i, col_name) in columns.iter().enumerate() {
            if i >= left.len() || i >= right.len() {
                continue;
            }

            if !Self::values_equal(&left[i], &right[i], options.float_tolerance) {
                changes.push((col_name.clone(), left[i].clone(), right[i].clone()));
            }
        }

        changes
    }
}

/// Result of a diff operation
#[derive(Debug)]
pub struct DiffResult {
    /// Path to left file
    pub left_path: String,

    /// Path to right file
    pub right_path: String,

    /// Schema differences
    pub schema_diff: SchemaDiff,

    /// Whether schema was compared (for display purposes)
    pub schema_compared: bool,

    /// Metadata differences
    pub metadata_diff: Option<MetadataDiff>,

    /// Statistics differences
    pub stats_diff: Option<StatsDiff>,

    /// Row-level differences (only when compare_data is true)
    pub row_diffs: Vec<RowDiff>,

    /// Summary statistics
    pub summary: DiffSummary,

    /// Left batches (for lazy materialization)
    pub left_batches: Vec<RecordBatch>,

    /// Right batches (for lazy materialization)
    pub right_batches: Vec<RecordBatch>,

    /// Left schema
    pub left_schema: Arc<Schema>,

    /// Right schema
    pub right_schema: Arc<Schema>,
}

impl DiffResult {
    /// Materialize a row from left batches to strings (lazy conversion)
    pub fn materialize_left_row(&self, location: RowLocation) -> Vec<(String, String)> {
        self.materialize_row(&self.left_batches, &self.left_schema, location)
    }

    /// Materialize a row from right batches to strings (lazy conversion)
    pub fn materialize_right_row(&self, location: RowLocation) -> Vec<(String, String)> {
        self.materialize_row(&self.right_batches, &self.right_schema, location)
    }

    /// Materialize a row to strings on demand
    fn materialize_row(
        &self,
        batches: &[RecordBatch],
        schema: &Schema,
        location: RowLocation,
    ) -> Vec<(String, String)> {
        let batch = &batches[location.batch_idx];
        let mut row_data = Vec::new();

        for field in schema.fields() {
            let col_name = field.name();
            if let Ok(col_idx) = schema.index_of(col_name) {
                let array = batch.column(col_idx);
                let value = Self::array_value_to_string(array, location.row_idx);
                row_data.push((col_name.clone(), value));
            }
        }

        row_data
    }

    /// Convert array value to string for display
    fn array_value_to_string(array: &ArrayRef, index: usize) -> String {
        if array.is_null(index) {
            return "NULL".to_string();
        }

        arrow::util::display::array_value_to_string(array, index)
            .unwrap_or_else(|_| "ERROR".to_string())
    }
}

/// Schema differences between two tables
#[derive(Debug, Clone, Default)]
pub struct SchemaDiff {
    /// Columns present in right but not in left
    pub columns_added: Vec<String>,

    /// Columns present in left but not in right
    pub columns_removed: Vec<String>,

    /// Columns with different types
    pub columns_type_changed: Vec<(String, DataType, DataType)>,

    /// All left schema columns with their types
    pub left_schema: Vec<(String, DataType)>,

    /// All right schema columns with their types
    pub right_schema: Vec<(String, DataType)>,
}

/// Metadata differences between two tables
#[derive(Debug, Clone)]
pub struct MetadataDiff {
    /// Number of rows (left, right)
    pub num_rows: Option<(i64, i64)>,

    /// Compressed size (left, right)
    pub compressed_size: Option<(u64, u64)>,

    /// Uncompressed size (left, right)
    pub uncompressed_size: Option<(u64, u64)>,

    /// Compression codec (left, right)
    pub compression: Option<(String, String)>,

    /// Format version (left, right)
    pub format_version: Option<(String, String)>,
}

/// Column statistics comparison
#[derive(Debug, Clone)]
pub struct ColumnStatsDiff {
    /// Column name
    pub name: String,

    /// Min value (left, right)
    pub min_value: Option<(String, String)>,

    /// Max value (left, right)
    pub max_value: Option<(String, String)>,

    /// Mean value (left, right) - for numeric columns
    pub mean: Option<(f64, f64)>,

    /// Null count (left, right)
    pub null_count: Option<(i64, i64)>,
}

/// Statistics differences between two tables
#[derive(Debug, Clone)]
pub struct StatsDiff {
    /// Per-column statistics comparison
    pub column_diffs: Vec<ColumnStatsDiff>,
}

/// Location of a row in batches (for lazy materialization)
#[derive(Debug, Clone, Copy)]
pub struct RowLocation {
    /// Index of the batch containing this row
    pub batch_idx: usize,

    /// Index of the row within the batch
    pub row_idx: usize,
}

/// A single row difference
#[derive(Debug, Clone)]
pub struct RowDiff {
    /// Type of difference
    pub diff_type: RowDiffType,

    /// Row identifier (hash or key)
    pub row_key: Option<u64>,

    /// Column-level changes (for modified rows)
    pub column_changes: Option<Vec<(String, String, String)>>,

    /// Left row location (for lazy materialization)
    pub left_row: Option<RowLocation>,

    /// Right row location (for lazy materialization)
    pub right_row: Option<RowLocation>,
}

/// Type of row difference
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum RowDiffType {
    /// Row exists in right but not in left
    Added,

    /// Row exists in left but not in right
    Removed,

    /// Row exists in both but values differ
    Modified,
}

/// Summary statistics for the diff
#[derive(Debug, Clone, Serialize, Default)]
pub struct DiffSummary {
    /// Total rows in left table
    pub left_rows: i64,

    /// Total rows in right table
    pub right_rows: i64,

    /// Rows that are identical
    pub rows_identical: i64,

    /// Rows added in right
    pub rows_added: i64,

    /// Rows removed in right
    pub rows_removed: i64,

    /// Rows with modifications
    pub rows_modified: i64,
}
